# ---------------------------------------------------------------- build output
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------ IDE
# The whole .idea directory, not just parts of it: workspace.xml records
# machine-specific paths and would churn on every clone.
.idea/
*.iml
*.iws
*.ipr
.vscode/

# --------------------------------------------------------------------- Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# -------------------------------------------------------------------- NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# -------------------------------------------------------------------------- OS
.DS_Store
Thumbs.db

# ------------------------------------------------- runtime state: never commit
# The app does NOT store anything inside the project. It writes to the user's
# home directory:
#     %USERPROFILE%\.dstokencheck\config.properties   <- holds apiKeyProtected
#     %USERPROFILE%\.dstokencheck\startup.log
# so a clone never contains a credential. The patterns below are a second line
# of defence in case a copy of those files is ever dropped into the project.
.dstokencheck/
config.properties
startup.log
*.log
secrets.properties
secrets.txt
*.key

# ------------------------------------------------- code signing: keys never get committed
# A .pfx/.p12 is the private key itself; leaking one means anyone can sign as this project.
# The public .cer is harmless, but keeping the whole family out removes the chance of a slip.
*.pfx
*.p12
*.pvk
*.snk
*.cer
